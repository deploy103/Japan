<!doctype html>
<html lang="ko">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="workspace">
    <section class="admin-shell" aria-labelledby="admin-title">
      <div class="workspace-heading">
        <div>
          <p class="eyebrow">회원 관리</p>
          <h1 id="admin-title">관리자 페이지</h1>
        </div>
        <div class="session-badge">총 <%= users.length %>명</div>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>캐시</th>
              <th>저장 항목</th>
              <th>재사용 횟수</th>
              <th>최근 갱신</th>
              <th>최근 재사용</th>
            </tr>
          </thead>
          <tbody>
            <% cacheStats.forEach((item) => { %>
              <tr>
                <td><strong><%= item.label %></strong></td>
                <td><%= item.item_count %></td>
                <td><%= item.hit_count %></td>
                <td><%= item.latest_update ? new Date(item.latest_update).toLocaleString('ko-KR') : '-' %></td>
                <td><%= item.latest_use ? new Date(item.latest_use).toLocaleString('ko-KR') : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>AI 사용량</th>
              <th>호출</th>
              <th>입력 토큰</th>
              <th>출력 토큰</th>
              <th>합계</th>
              <th>최근 사용</th>
            </tr>
          </thead>
          <tbody>
            <% if (aiUsageStats.length === 0) { %>
              <tr><td colspan="6" class="empty-cell">아직 기록된 AI 사용량이 없습니다.</td></tr>
            <% } else { %>
              <% aiUsageStats.forEach((item) => { %>
                <tr>
                  <td><strong><%= item.label %></strong></td>
                  <td><%= item.request_count %></td>
                  <td><%= item.input_tokens %></td>
                  <td><%= item.output_tokens %></td>
                  <td><strong><%= item.total_tokens %></strong></td>
                  <td><%= item.latest_use ? new Date(item.latest_use).toLocaleString('ko-KR') : '-' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>보안 이벤트</th>
              <th>아이디</th>
              <th>IP 해시</th>
              <th>상세</th>
              <th>시각</th>
            </tr>
          </thead>
          <tbody>
            <% if (securityEvents.length === 0) { %>
              <tr><td colspan="5" class="empty-cell">최근 보안 이벤트가 없습니다.</td></tr>
            <% } else { %>
              <% securityEvents.forEach((event) => { %>
                <tr>
                  <td><span class="security-event-pill security-event-<%= event.event_type %>"><%= event.label %></span></td>
                  <td><%= event.username || '-' %></td>
                  <td><%= event.ip_hash_short || '-' %></td>
                  <td><%= event.detail || '-' %></td>
                  <td><%= event.created_at ? new Date(event.created_at).toLocaleString('ko-KR') : '-' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>아이디</th>
              <th>복구 이메일</th>
              <th>권한</th>
              <th>상태</th>
              <th>활성 세션</th>
              <th>최근 로그인</th>
              <th>관리</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td><strong><%= user.username %></strong></td>
                <td><%= user.recovery_email %></td>
                <td><span class="role-pill <%= user.role === 'admin' ? 'role-admin' : '' %>"><%= user.role %></span></td>
                <td><span class="status-pill <%= user.is_active ? 'status-active' : 'status-disabled' %>"><%= user.is_active ? '활성' : '비활성' %></span></td>
                <td><%= user.active_sessions %></td>
                <td><%= user.last_login_at ? new Date(user.last_login_at).toLocaleString('ko-KR') : '-' %></td>
                <td>
                  <% if (user.id === currentUser.id) { %>
                    <span class="muted">본인</span>
                  <% } else { %>
                    <div class="admin-actions">
                      <form action="/admin/users/<%= user.id %>/status" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="small-button" type="submit"><%= user.is_active ? '비활성화' : '활성화' %></button>
                      </form>
                      <form action="/admin/users/<%= user.id %>/role" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="small-button" type="submit"><%= user.role === 'admin' ? '일반 권한' : '관리자 권한' %></button>
                      </form>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
